# ============================================================
# Hor Tong Mong — environment template
# Copy to `.env` and fill in real values.
# ============================================================

# --- Database (Supabase Postgres) ---
# Use the Session pooler string (IPv4-compatible). Supabase Dashboard >
# Settings > Database > Connection string > "Session pooler".
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase API (client-side) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# --- Auth.js v5 ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Payments (stubbed) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
